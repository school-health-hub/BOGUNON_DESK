// File paths never cross the main-world bridge. Only trusted native File drops enter this private channel.
if(typeof window!=='undefined'&&typeof document!=='undefined'&&process.isMainFrame!==false&&webUtils){
 const files=(e:DragEvent)=>e.dataTransfer&&Array.from(e.dataTransfer.types).includes('Files');
 window.addEventListener('dragover',e=>{if(files(e)){e.preventDefault();if(e.dataTransfer)e.dataTransfer.dropEffect='copy';}},true);
 window.addEventListener('drop',e=>{
  if(!files(e))return;e.preventDefault();e.stopImmediatePropagation();
  if(!e.isTrusted)return;
  let paths:string[]=[];try{const selected=Array.from(e.dataTransfer!.files);if(!selected.length||selected.length>50)throw Error();paths=selected.map(file=>{const path=webUtils.getPathForFile(file);if(!path)throw Error();return path;});}catch{paths=[];}
  void projectCall('p2:drop:stage',paths);
 },true);
}
