{
  "appId": "kr.sungandi.schoolhealthdesk.electronp0",
  "productName": "BOGUNON DESK ELECTRON P0",
  "directories": {
    "app": "build/electron-p0-app",
    "output": "release-electron-p0"
  },
  "files": [
    "main/**",
    "preload/**",
    "protocol.js",
    "purchase-image-protocol.js",
    "chatgpt-protocol.js",
    "inventory-qa-protocol.js",
    "local-tasks.js",
    "local-events.js",
    "admin-protocol.js",
    "school-protocol.js",
    "school-launcher.js",
    "renderer/**",
    "build-meta.json",
    "package.json",
    "tray.png",
    "purchase-ai-protocol.js",
    "ai-image-capabilities.json",
    "admin-connection.js"
  ],
  "asar": true,
  "npmRebuild": false,
  "publish": null,
  "artifactName": "BOGUNON-DESK-ELECTRON-P0-${version}-${os}-${arch}.${ext}",
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "src-tauri/icons/icon.ico",
    "signAndEditExecutable": false,
    "extraResources": [
      {
        "from": "build/my-finance-cli",
        "to": "my-finance-cli",
        "filter": [
          "my-finance-cli.exe"
        ]
      }
    ]
  },
  "linux": {
    "target": "dir",
    "category": "Office"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": false,
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false,
    "shortcutName": "BOGUNON DESK ELECTRON P0",
    "uninstallDisplayName": "BOGUNON DESK ELECTRON P0",
    "artifactName": "BOGUNON-DESK-ELECTRON-P0-Setup-${version}-${arch}.${ext}"
  },
  "extraResources": [
    {
      "from": "build/purchase-excel-cli",
      "to": "purchase-excel-cli",
      "filter": [
        "purchase-excel-cli.exe",
        "purchase-excel-cli"
      ]
    },
    {
      "from": "build/official-document-cli",
      "to": "official-document-cli",
      "filter": [
        "official-document-cli.exe",
        "official-document-cli"
      ]
    },
    {
      "from": "build/purchase-ocr",
      "to": "purchase-ocr",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "build/purchase-ocr/node_modules",
      "to": "purchase-ocr/node_modules",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "build/chatgpt-auth-cli",
      "to": "chatgpt-auth-cli",
      "filter": [
        "chatgpt-auth-cli.exe",
        "chatgpt-auth-cli",
        "manifest.json"
      ]
    },
    {
      "from": "build/record-helper-cli",
      "to": "record-helper-cli",
      "filter": [
        "record-helper-cli.exe",
        "record-helper-cli",
        "manifest.json"
      ]
    }
  ],
  "beforePack": "./scripts/electron-p0/check-excel-package.cjs"
}
