{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOGUNON DESK FINDER INTEGRATION QA",
  "identifier": "kr.sungandi.schoolhealthdesk.finderintegrationqa",
  "mainBinaryName": "bogunon-desk-finder-integration-qa",
  "build": {
    "beforeBuildCommand": null,
    "beforeDevCommand": null,
    "devUrl": null,
    "frontendDist": "../dist-finder-integration-qa"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "BOGUNON DESK 교육영상 Finder 통합 QA — 합성 자료 전용",
      "width": 1440,
      "height": 900,
      "minWidth": 390,
      "minHeight": 640,
      "devtools": true,
      "dataDirectory": null
    }],
    "security": {
      "capabilities": [{
        "identifier": "finder-integration-qa-only",
        "windows": ["main"],
        "permissions": ["core:default", "core:window:allow-close"]
      }],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "worker-src": "'none'"
      }
    }
  },
  "plugins": { "updater": null, "deep-link": null },
  "bundle": { "active": false, "createUpdaterArtifacts": false }
}
