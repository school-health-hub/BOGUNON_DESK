{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOGUNON DESK OFFICIAL DOCUMENT QA",
  "identifier": "kr.sungandi.schoolhealthdesk.officialdocumentqa",
  "mainBinaryName": "bogunon-desk-official-document-qa",
  "build": {
    "beforeBuildCommand": "node scripts/build-official-document-qa-frontend.mjs",
    "frontendDist": "../dist-official-document-qa",
    "devUrl": null,
    "beforeDevCommand": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BOGUNON DESK 공문작업실 QA — 합성 자료 전용",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "dataDirectory": "official-document-qa-webview"
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "official-document-qa-only",
          "windows": ["main"],
          "permissions": ["core:default", "core:window:allow-close"]
        }
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "worker-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "worker-src": "'none'"
      }
    }
  },
  "plugins": {
    "updater": null,
    "deep-link": null
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false
  }
}
