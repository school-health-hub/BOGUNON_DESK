{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOGUNON DESK MY FINANCE QA",
  "identifier": "kr.sungandi.schoolhealthdesk.myfinanceqa",
  "mainBinaryName": "bogunon-desk-my-finance-qa",
  "build": {
    "beforeBuildCommand": "node scripts/build-my-finance-qa-frontend.mjs",
    "frontendDist": "../dist-my-finance-qa",
    "devUrl": null,
    "beforeDevCommand": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BOGUNON DESK MY FINANCE QA — SYNTHETIC ONLY",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "my-finance-qa-only",
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "finance-qa-commands"
          ],
          "webviews": [
            "main"
          ]
        }
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "worker-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "worker-src": "'none'"
      }
    }
  },
  "plugins": {
    "updater": null,
    "deep-link": null
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
